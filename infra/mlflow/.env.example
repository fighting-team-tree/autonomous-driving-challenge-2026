# infra/mlflow/.env 로 복사해서 채운다. 이 파일은 VM 에만 존재하며 커밋되지 않는다.
#   cp .env.example .env
#
# 주의: 이건 **서버 배포용**이다. 학습 클라이언트용 설정은 저장소 루트의 .env 다.

# ── Postgres ─────────────────────────────────────────────────────────
# URL-safe 문자만 사용할 것 (backend-store-uri 에 그대로 들어간다).
# 생성:  openssl rand -hex 24
POSTGRES_PASSWORD=

# ── R2 (artifact 저장소) ─────────────────────────────────────────────
# 이 키는 서버만 갖는다. 학습 클라이언트에는 뿌리지 않는다.
# 데이터 다운로드용 읽기 전용 키와 분리해서 발급할 것.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=

# ── 공개 주소 ────────────────────────────────────────────────────────
# 도메인이 없으면 sslip.io 를 쓴다. <VM 공인 IP>.sslip.io 가 그 IP로 해석되고
# Let's Encrypt 인증서도 발급된다. 도메인 구매 불필요.
#   예: 203.0.113.7.sslip.io
MLFLOW_HOSTNAME=

# Let's Encrypt 만료 알림 수신 주소
ACME_EMAIL=
