# 이 파일을 .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env

# ── Cloudflare R2 (원본 데이터 + MLflow artifact 저장소) ────────────
# R2는 egress가 무료라 Colab/Runpod로 반복 다운로드해도 전송 비용이 0이다.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── MLflow tracking server (클라우드 VM 상시 구동) ──────────────────
# seed / 하이퍼파라미터 / split 등 재현에 필요한 값은 전부 여기 남긴다.
# 마크다운 문서에는 적지 않는다 (레포가 public이므로).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
