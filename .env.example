# 이 파일을 .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env
#
# 이건 **학습 클라이언트용**이다. MLflow 서버 배포용 설정은 infra/mlflow/.env 다.

# ── MLflow (클라우드 VM) ──────────────────────────────────────────────
# seed / 하이퍼파라미터 / split 등 재현에 필요한 값은 전부 여기 남긴다.
# 마크다운 문서에는 적지 않는다 (레포가 public이므로).
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# ── Cloudflare R2 (데이터셋 다운로드용) ───────────────────────────────
# R2는 egress가 무료라 Colab/Runpod로 반복 다운로드해도 전송 비용이 0이다.
#
# artifact 업로드에는 이 키가 필요 없다 — MLflow 서버가 대리 전송한다.
# 따라서 여기에는 **읽기 전용 키**를 쓰는 것을 권장한다.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
